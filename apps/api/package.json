{
  "name": "@flowdesk/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts src/cli.ts --outdir=dist --bundle --platform=node --format=esm --target=node26 --packages=external --alias:@flowdesk/shared=../../packages/shared/src/index.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/cli.ts migrate",
    "test": "vitest run --config ../../vitest.workspace.ts --project api-unit --project api-integration",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.3.0",
    "@flowdesk/shared": "workspace:*",
    "drizzle-orm": "~0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "~0.31.11",
    "esbuild": "^0.28.2",
    "testcontainers": "^12.2.2",
    "tsx": "^4.23.15"
  }
}
