# DESARROLLO LOCAL — valores ficticios para compose.dev.yaml y tsx.
POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=flowdesk_dev_only
POSTGRES_DB=flowdesk
DATABASE_URL=postgresql://flowdesk:flowdesk_dev_only@127.0.0.1:5432/flowdesk
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# TRUST_PROXY_CIDR=172.30.0.1/32
DEMO_SPACE_TTL_MIN=120
DEMO_IDLE_MIN=30
DEMO_MAX_REQUESTS=30
DEMO_SPACES_PER_IP_HOUR=10
DEMO_MAX_ACTIVE_SPACES=500
RATE_LIMIT_PER_MIN=120
# Límite global por IP, además del límite por sesión; incluye salud y rutas desconocidas.
RATE_LIMIT_PER_IP_MIN=300
BODY_LIMIT_BYTES=16384
CLEANUP_INTERVAL_MIN=10
CLEANUP_GRACE_MIN=15
CLEANUP_BATCH=50

# PRODUCCIÓN / COMPOSE — valores ficticios; ver docs/despliegue/README.md.
# Para compose.yaml, SUSTITUIR los valores anteriores, sin duplicar las claves:
# POSTGRES_PASSWORD=change-me
# APP_ORIGIN=https://flowdesk.example.com
# compose.yaml fija NODE_ENV=production y construye DATABASE_URL usando
# POSTGRES_USER, POSTGRES_PASSWORD y POSTGRES_DB; no usa DATABASE_URL ni PORT
# de la sección de desarrollo. Los límites de demo anteriores sí se aplican.
FLOWDESK_DOMAIN=flowdesk.example.com
FLOWDESK_IMAGE_REGISTRY=ghcr.io/alesobdpl
FLOWDESK_IMAGE_TAG=local
FLOWDESK_API_PORT=4000
FLOWDESK_WEB_PORT=3000
FLOWDESK_PROXY_PORT=8080
# Prueba local con Caddy: sustituir APP_ORIGIN por http://127.0.0.1:8080.
# Si 3000 está ocupado, cambiar FLOWDESK_WEB_PORT (por ejemplo, a 3300).
